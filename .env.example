# ─────────────────────────────────────────────────────────────
# DEENO – Umgebungsvariablen
# Kopieren nach .env.local (lokal) bzw. in Vercel → Settings → Environment Variables.
# Niemals echte Zugangsdaten in das Repository einchecken.
# ─────────────────────────────────────────────────────────────

# Suchmaschinen: erst auf "true" setzen, wenn Impressum & Datenschutz fertig sind
SITE_INDEXING="false"

# Öffentliche Basis-URL (für Sitemap, Open Graph, E-Mail-Links)
NEXT_PUBLIC_SITE_URL="https://www.ihre-domain.de"

# ── Datenbank (PostgreSQL) ───────────────────────────────────
# z. B. Vercel Postgres / Neon / Supabase. Für lokale Tests: npm run db:local
# Supabase: DATABASE_URL = Transaction-Pooler (Port 6543), DIRECT_URL = Session-Pooler (Port 5432, nur für Migrationen)
DIRECT_URL=""
DATABASE_URL="postgresql://USER:PASSWORT@HOST:5432/DATENBANK?sslmode=require"
# Optional: maximale Verbindungen pro Server-Instanz (Serverless: klein halten)
DATABASE_POOL_MAX="5"

# ── E-Mail-Versand (Resend, https://resend.com) ──────────────
RESEND_API_KEY=""
# Absender MUSS eine bei Resend verifizierte Domain verwenden (nicht @yahoo.com!)
MAIL_FROM="DEENO Chauffeurservice <anfragen@ihre-domain.de>"
# Empfänger für Betreiber-Benachrichtigungen
MAIL_OPERATOR_TO="Firmawajdideeno@yahoo.com"
# Antwortadresse in Kunden-E-Mails
MAIL_REPLY_TO="Firmawajdideeno@yahoo.com"
# "resend" (Standard, wenn API-Key gesetzt) oder "log" (nur Entwicklung: E-Mails werden in der Konsole ausgegeben, NICHT versendet)
MAIL_TRANSPORT=""

# ── Adress-Autovervollständigung & Routen (Google Maps Platform) ─
# Benötigt: Places API (New). Für spätere Routenberechnung: Routes API.
# Der Schlüssel wird ausschließlich serverseitig verwendet (Proxy unter /api/places).
GOOGLE_MAPS_API_KEY=""
# Routenberechnung (Distanz/Dauer) bei neuen Anfragen speichern: "true" | "false"
ROUTE_CALCULATION_ENABLED="false"

# ── Online-Zahlung (Stripe, https://stripe.com) ─────────────
# Testmodus: sk_test_… / whsec_… aus dem Stripe-Dashboard bzw. `stripe listen`
STRIPE_SECRET_KEY=""
# Webhook-Endpunkt: https://www.ihre-domain.de/api/stripe/webhook
# Ereignisse: checkout.session.completed, checkout.session.async_payment_succeeded,
#             checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=""
# Erst auf "true" setzen, wenn DEENO verbindliche Sofortbuchungen anbieten will
INSTANT_BOOKING_ENABLED="false"
# Mindestvorlauf in Stunden für sofort bezahlbare Fahrten
MIN_LEAD_HOURS="24"
# Bestätigte Preisregeln (JSON, alle Beträge in EUR). Leer = nur "Unverbindliches Angebot anfordern".
# Beispielstruktur (KEINE echten Preise!):
# {"version":"2026-01","currency":"EUR","airportSurcharge":0,"perStop":0,"extras":{},
#  "perVehicle":{"business":{"baseFare":0,"perKm":0,"perMinute":0,"hourlyRate":0,"minimumFare":0},
#                "first":{...},"van":{...}}}
# Hinweis: Streckenpreise benötigen GOOGLE_MAPS_API_KEY + ROUTE_CALCULATION_ENABLED="true".
PRICING_RULES_JSON=""

# ── Administrationsbereich (/admin) ──────────────────────────
ADMIN_USERNAME="deeno"
# Erzeugen mit: npm run admin:hash -- "IhrSicheresPasswort"
ADMIN_PASSWORD_HASH=""
# Zufälliger, geheimer Wert (mind. 32 Zeichen), z. B.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=""
# Zwei-Faktor-Anmeldung (TOTP, Pflicht in Produktion). Erzeugen mit: npm run admin:totp
# Ohne diesen Wert ist die Admin-Anmeldung in Produktion gesperrt.
ADMIN_TOTP_SECRET=""
# Nur im Notfall: "true" erlaubt die Anmeldung in Produktion OHNE 2FA (nicht empfohlen)
ADMIN_MFA_OPTIONAL=""
# Optional: eigener Schlüssel zum Pseudonymisieren der Rate-Limit-Einträge (sonst ADMIN_SESSION_SECRET)
RATE_LIMIT_SECRET=""

# ── Bot-Schutz (Cloudflare Turnstile, https://dash.cloudflare.com → Turnstile) ──
# Aktiv nur, wenn BEIDE Werte gesetzt sind. Site Key ist öffentlich, Secret Key geheim.
# Nach Änderung des Site Keys neu deployen (wird beim Build eingebunden).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Kontakt-Kanäle ───────────────────────────────────────────
# WhatsApp-Nummer im internationalen Format ohne + (vor Livegang bestätigen!)
NEXT_PUBLIC_WHATSAPP_NUMBER="491607703472"
