{
  "name": "deeno-chauffeur",
  "version": "1.0.0",
  "private": true,
  "description": "DEENO Chauffeur- und Limousinenservice – Website mit Buchungsanfragesystem",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:new": "supabase migration new",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:status": "supabase migration list --remote",
    "db:push": "supabase db push --remote",
    "admin:hash": "node scripts/hash-password.mjs",
    "admin:totp": "node scripts/totp-secret.mjs",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.mjs",
    "test": "playwright test",
    "test:visual": "node tests/visual/capture.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^6.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "gsap": "^3.15.0",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.35.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9"
  }
}
