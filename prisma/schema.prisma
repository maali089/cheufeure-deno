// DEENO – Datenmodell für Buchungsanfragen, Kontaktanfragen und Flotten-Einstellungen.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  RECEIVED     // Eingegangen
  IN_PROGRESS  // In Bearbeitung
  CONFIRMED    // Bestätigt
  REJECTED     // Abgelehnt
  COMPLETED    // Abgeschlossen
  CANCELLED    // Storniert (nach Bestätigung abgesagt)
}

enum PaymentStatus {
  NOT_REQUIRED // Anfrage ohne Online-Zahlung
  PENDING      // Checkout gestartet
  PAID         // Zahlung bestätigt (Webhook)
  FAILED
  EXPIRED
  REFUNDED
}

enum TripType {
  ONE_WAY     // Einzelfahrt
  ROUND_TRIP  // Hin- und Rückfahrt
  AIRPORT     // Flughafentransfer
  HOURLY      // Stundenbuchung
}

model BookingRequest {
  id        String        @id @default(cuid())
  reference String        @unique
  status    BookingStatus @default(RECEIVED)

  // Fahrt
  tripType       TripType
  pickupAddress  String
  pickupPlaceId  String?
  dropoffAddress String?
  dropoffPlaceId String?
  stops          String[]
  pickupDate     String // YYYY-MM-DD (Ortszeit Europe/Berlin)
  pickupTime     String // HH:MM
  returnDate     String?
  returnTime     String?
  durationHours  Int?
  passengers     Int
  luggage        Int
  flightNumber   String?
  tripNotes      String?

  // Fahrzeug
  vehicleClass String

  // Kunde
  firstName       String
  lastName        String
  email           String
  phone           String
  company         String?
  specialRequests String?
  privacyAckAt    DateTime

  // Vorbereitung für spätere Preiskalkulation (aktuell nicht automatisch befüllt)
  distanceMeters  Int?
  durationSeconds Int?
  quotedPrice     Decimal? @db.Decimal(10, 2)
  currency        String   @default("EUR")
  pricingSource   String?  // z. B. "manual", "rules:v1"

  // Preisabsprache per WhatsApp/Telefon – nur der Betreiber trägt den Preis ein
  agreedPrice        Decimal?  @db.Decimal(10, 2)
  priceAgreedAt      DateTime?
  confirmedAt        DateTime?
  confirmationSentAt DateTime? // Bestätigungs-E-Mail an den Kunden versendet

  // Online-Zahlung (Stripe) – keine Kartendaten auf eigenem Server
  paymentStatus           PaymentStatus @default(NOT_REQUIRED)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  amountPaidCents         Int?
  paidAt                  DateTime?

  // Benachrichtigungen
  operatorNotifiedAt DateTime?
  customerNotifiedAt DateTime?
  notificationError  String?

  adminNotes String?

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  statusHistory BookingStatusChange[]

  @@index([status, createdAt])
  @@index([pickupDate])
}

model BookingStatusChange {
  id         String         @id @default(cuid())
  bookingId  String
  booking    BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  note       String?
  changedBy  String
  changedAt  DateTime       @default(now())

  @@index([bookingId, changedAt])
}

model ContactMessage {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  emailSentAt DateTime?
  emailError  String?
  handled     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// Administrierbare Flotten-Einstellungen. Stammdaten (Name, Kapazität, Ausstattung)
// liegen in src/config/fleet.ts, Verfügbarkeit und Freigabe werden hier gepflegt.
model FleetSetting {
  slug      String   @id
  enabled   Boolean  @default(true)  // in Buchungsformular anfragbar
  confirmed Boolean  @default(false) // vom Unternehmen als tatsächlich verfügbar bestätigt
  note      String?
  updatedAt DateTime @updatedAt
}

// Verarbeitete Stripe-Webhook-Ereignisse (Idempotenz: jedes Ereignis nur einmal)
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

// Serverseitige Admin-Sitzungen: ermöglichen echtes Abmelden (Widerruf) und Leerlauf-Timeout.
// Gespeichert wird nur ein SHA-256-Hash der Sitzungs-ID, nie das Cookie selbst.
model AdminSession {
  id         String    @id // SHA-256 (hex) der zufälligen Sitzungs-ID aus dem Cookie
  username   String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([expiresAt])
}

// Bereits verwendete TOTP-Codes (2FA) – verhindert die Wiederverwendung eines Codes.
model AdminTotpUse {
  username String
  step     Int // Zeitschritt (Unix-Zeit / 30 s)
  usedAt   DateTime @default(now())

  @@id([username, step])
}

// Zentrales Rate-Limit (gilt über alle Server-Instanzen). Schlüssel sind HMAC-Hashes,
// es werden keine IP-Adressen oder E-Mail-Adressen im Klartext gespeichert.
model RateLimitBucket {
  key           String @id
  count         Int
  windowStartMs BigInt

  @@index([windowStartMs])
}
